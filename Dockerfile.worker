# DocuFlow worker: claims QUEUED jobs from the shared database and processes the uploaded files.
FROM node:20-alpine
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY server/ ./server/
RUN rm -rf server/tests server/coverage server/data && mkdir -p /app/data/uploads && chown -R node:node /app/data
USER node
ENV NODE_ENV=production SERVICE_NAME=docuflow-worker
# Healthy while this worker's heartbeat in the shared database is recent.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "const os=require('os');const db=new (require('better-sqlite3'))('/app/data/docuflow.db',{readonly:true});const r=db.prepare('SELECT last_heartbeat_at FROM workers WHERE id=?').get(process.env.WORKER_ID||os.hostname());process.exit(r&&Date.now()-Date.parse(r.last_heartbeat_at)<30000?0:1)"
CMD ["node", "server/worker.js"]
