# Copy to .env (never commit it). Values below are placeholders.
SPLUNK_ADMIN_PASSWORD=change-me
SPLUNK_HEC_TOKEN=replace-with-logs-token
SPLUNK_METRICS_HEC_TOKEN=replace-with-metrics-token
# Used when the API and worker run directly on this machine (npm start). Containers use DOCKER_SPLUNK_HEC_URL instead.
SPLUNK_HEC_URL=https://127.0.0.1:8088/services/collector/event
SPLUNK_HEC_INSECURE_TLS=true
SPLUNK_REST_URL=https://127.0.0.1:8089
SPLUNK_REST_TOKEN=replace-with-read-only-rest-token
SPLUNK_REST_INSECURE_TLS=true
# Optional overrides for Docker Compose (defaults point at Splunk on the Docker host).
# DOCKER_SPLUNK_HEC_URL=https://host.docker.internal:8088/services/collector/event
# DOCKER_SPLUNK_REST_URL=https://host.docker.internal:8089
APP_VERSION=1.0.0
DEMO_MODE=true
# Delay used by /api/demo/slow-job, in milliseconds.
DEMO_SLOW_JOB_MS=8000
